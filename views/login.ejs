<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
    rel="stylesheet"
>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Login | VardaOne</title>

    <link
        rel="stylesheet"
        href="/css/login.css"
    >
</head>


<body>


<!-- =====================================================
     NAVBAR
===================================================== -->

<nav class="login-navbar">


    <a href="/" class="brand">

        <img
            src="/logos/vsclogo.png"
            alt="VardaSustain"
            class="vsc-logo"
        >

        <span class="brand-divider"></span>


        <div class="vardaone-brand">

            <div class="vardaone-name">
                Varda<span>One</span>
            </div>

            <small>
                Sustainability Data Intelligence Platform
            </small>

        </div>

    </a>


    <a href="/" class="back-home">

        <span>Back to Home</span>

        <b>↗</b>

    </a>


</nav>



<!-- =====================================================
     LOGIN PAGE
===================================================== -->

<main class="login-page">


    <div class="background-grid"></div>


    <div class="dot-pattern">

        <% for(let i = 0; i < 56; i++) { %>
            <i></i>
        <% } %>

    </div>



    <div class="login-container">


        <!-- =================================================
             LEFT SECTION
        ================================================= -->


        <section class="login-intro">


            <span class="intro-label">
                VARDAONE WORKSPACE
            </span>


            <h1>

                Sustainability data,

                <span>
                    connected.
                </span>

            </h1>


            <p class="intro-description">

                Access your organisation's workspace to collect
                activity data, manage supporting evidence and
                work with structured emissions information.

            </p>



            <!-- FEATURES -->


            <div class="feature-list">


                <!-- FEATURE 1 -->

                <div class="feature-item">


                    <div class="feature-icon">

                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >

                            <ellipse
                                cx="12"
                                cy="5"
                                rx="7"
                                ry="3"
                            />

                            <path
                                d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5"
                            />

                            <path
                                d="M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"
                            />

                        </svg>

                    </div>


                    <span class="feature-number">
                        01
                    </span>


                    <div class="feature-copy">

                        <strong>
                            Structured Data
                        </strong>

                        <p>
                            Organised by company, facility and reporting period.
                        </p>

                    </div>


                </div>



                <!-- FEATURE 2 -->

                <div class="feature-item">


                    <div class="feature-icon">

                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >

                            <path
                                d="M6 2h8l4 4v16H6z"
                            />

                            <path
                                d="M14 2v5h5"
                            />

                            <path
                                d="M9 12h6M9 16h6"
                            />

                        </svg>

                    </div>


                    <span class="feature-number">
                        02
                    </span>


                    <div class="feature-copy">

                        <strong>
                            Evidence Linked
                        </strong>

                        <p>
                            Source documents connected with activity records.
                        </p>

                    </div>


                </div>



                <!-- FEATURE 3 -->

                <div class="feature-item">


                    <div class="feature-icon">

                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >

                            <rect
                                x="4"
                                y="3"
                                width="16"
                                height="18"
                                rx="2"
                            />

                            <path
                                d="M8 7h8M8 12h2M12 12h2M16 12h1M8 16h2M12 16h2M16 16h1"
                            />

                        </svg>

                    </div>


                    <span class="feature-number">
                        03
                    </span>


                    <div class="feature-copy">

                        <strong>
                            Calculation Ready
                        </strong>

                        <p>
                            A structured foundation for emissions calculation.
                        </p>

                    </div>


                </div>


            </div>


        </section>



        <!-- =================================================
             LOGIN CARD
        ================================================= -->


        <section class="login-card">


            <div class="card-header">


                <span class="access-label">
                    SECURE WORKSPACE ACCESS
                </span>


                <h2>
                    Welcome back.
                </h2>


                <p>
                    Sign in using your VardaOne workspace credentials.
                </p>


            </div>



            <!-- ERROR MESSAGE -->

            <% if (typeof error !== "undefined" && error) { %>

                <div class="error-box">

                    <span>!</span>

                    <p>
                        <%= error %>
                    </p>

                </div>

            <% } %>



            <!-- LOGIN FORM -->


            <form
                action="/login"
                method="POST"
                class="login-form"
            >


                <!-- EMAIL -->

                <div class="form-group">


                    <label for="email">
                        EMAIL ADDRESS
                    </label>


                    <div class="input-box">


                        <span class="input-icon">
                            @
                        </span>


                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email address"
                            autocomplete="email"
                            required
                        >


                    </div>


                </div>



                <!-- PASSWORD -->

                <div class="form-group">


                    <div class="label-row">


                        <label for="password">
                            PASSWORD
                        </label>


                        <a href="/forgot-password">
                            Forgot password?
                        </a>


                    </div>


                    <div class="input-box">


                        <span class="input-icon lock-icon">

                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >

                                <rect
                                    x="5"
                                    y="10"
                                    width="14"
                                    height="11"
                                    rx="2"
                                />

                                <path
                                    d="M8 10V7a4 4 0 018 0v3"
                                />

                            </svg>

                        </span>


                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >


                        <button
                            type="button"
                            class="password-toggle"
                            id="passwordToggle"
                        >
                            Show
                        </button>


                    </div>


                </div>



                <!-- LOGIN BUTTON -->

                <button
                    type="submit"
                    class="login-button"
                >

                    <span>
                        Enter Workspace
                    </span>

                    <b>
                        →
                    </b>

                </button>


            </form>



            <!-- CARD FOOTER -->

            <div class="card-security">


                <div class="security-icon">

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >

                        <path
                            d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"
                        />

                        <path
                            d="M9 12l2 2 4-4"
                        />

                    </svg>

                </div>


                <p>

                    Access is restricted to authorised
                    VardaOne workspace users.

                </p>


            </div>


        </section>


    </div>


</main>



<!-- =====================================================
     FOOTER
===================================================== -->

<footer class="login-footer">


    <span>
        © 2026 VardaSustain Consulting. All rights reserved.
    </span>


    <div class="footer-links">

        <a href="/privacy">
            Privacy
        </a>

        <i></i>

        <a href="/security">
            Security
        </a>

        <i></i>

        <a href="/support">
            Support
        </a>

        <i></i>

        <a href="/contact">
            Contact
        </a>

    </div>


</footer>



<!-- =====================================================
     PASSWORD SHOW / HIDE
===================================================== -->

<script>

    const passwordInput =
        document.getElementById("password");

    const passwordToggle =
        document.getElementById("passwordToggle");


    passwordToggle.addEventListener("click", () => {

        const hidden =
            passwordInput.type === "password";


        passwordInput.type =
            hidden ? "text" : "password";


        passwordToggle.textContent =
            hidden ? "Hide" : "Show";

    });

</script>


</body>

</html>