<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>

(() => {


    /* =============================================
       ELEMENTS
    ============================================= */

    const navbar =
        document.getElementById("navbar");


    const wave =
        document.getElementById("dotWave");


    const navLinks =
        [...document.querySelectorAll(".nav-links a")];


    const sections =
        [...document.querySelectorAll("section[id]")];


    const reducedMotion =
        window.matchMedia(
            "(prefers-reduced-motion: reduce)"
        ).matches;



    /* =============================================
       NAVBAR SCROLL EFFECT
    ============================================= */

    const onScroll = () => {


        navbar.classList.toggle(
            "scrolled",
            window.scrollY > 24
        );


        let current = "";


        sections.forEach(section => {

            if (
                window.scrollY >=
                section.offsetTop - 180
            ) {

                current = section.id;

            }

        });


        navLinks.forEach(link => {

            link.classList.toggle(

                "active",

                link.getAttribute("href")
                === "#" + current

            );

        });

    };


    window.addEventListener(

        "scroll",

        onScroll,

        {
            passive: true
        }

    );


    onScroll();



    /* =============================================
       HERO DOTTED PARALLAX
    ============================================= */

    if (!reducedMotion && wave) {


        window.addEventListener(

            "mousemove",

            event => {


                const x =

                    (
                        event.clientX /
                        window.innerWidth
                        - 0.5
                    ) * 12;


                const y =

                    (
                        event.clientY /
                        window.innerHeight
                        - 0.5
                    ) * 10;


                wave.style.setProperty(
                    "--px",
                    x + "px"
                );


                wave.style.setProperty(
                    "--py",
                    y + "px"
                );

            },

            {
                passive: true
            }

        );

    }



    /* =============================================
       SCROLL REVEAL
    ============================================= */

    const revealObserver =

        new IntersectionObserver(

            entries => {


                entries.forEach(entry => {


                    if (
                        entry.isIntersecting
                    ) {


                        entry.target
                            .classList
                            .add("visible");


                        revealObserver
                            .unobserve(
                                entry.target
                            );

                    }

                });

            },

            {
                threshold: 0.12
            }

        );


    document
        .querySelectorAll(".reveal")
        .forEach(element => {

            revealObserver.observe(element);

        });



    /* =============================================
       WORKFLOW ANIMATION
    ============================================= */

    const progressObserver =

        new IntersectionObserver(

            entries => {


                entries.forEach(entry => {


                    if (
                        entry.isIntersecting
                    ) {

                        entry.target
                            .classList
                            .add("animate");

                    }

                });

            },

            {
                threshold: 0.35
            }

        );


    const lineage =
        document.getElementById("lineage");


    const workflow =
        document.getElementById(
            "animatedWorkflow"
        );


    if (lineage) {

        progressObserver.observe(lineage);

    }


    if (workflow) {

        progressObserver.observe(workflow);

    }



    /* =============================================
       METRIC COUNT-UP
    ============================================= */

    const metricObserver =

        new IntersectionObserver(

            entries => {


                entries.forEach(entry => {


                    if (
                        !entry.isIntersecting ||
                        entry.target.dataset.done
                    ) {

                        return;

                    }


                    entry.target.dataset.done = "1";


                    const end = Number(
                        entry.target.dataset.count
                    );


                    if (reducedMotion) {


                        entry.target.textContent =

                            String(end).padStart(

                                end < 10 ? 2 : 1,

                                "0"

                            );


                        return;

                    }


                    const duration = 900;

                    const start =
                        performance.now();


                    const tick = now => {


                        const progress =

                            Math.min(

                                (now - start) /
                                duration,

                                1

                            );


                        const value =

                            Math.floor(

                                end *

                                (
                                    1 -
                                    Math.pow(
                                        1 - progress,
                                        3
                                    )
                                )

                            );


                        entry.target.textContent =

                            String(value).padStart(

                                end < 10 ? 2 : 1,

                                "0"

                            );


                        if (progress < 1) {

                            requestAnimationFrame(
                                tick
                            );

                        }

                    };


                    requestAnimationFrame(tick);

                });

            },

            {
                threshold: 0.6
            }

        );


    document
        .querySelectorAll("[data-count]")
        .forEach(element => {

            metricObserver.observe(element);

        });


})();

</script>


</body>

</html>